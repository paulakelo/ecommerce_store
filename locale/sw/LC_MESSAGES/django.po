#: store/views.py:275
msgid ""
"We could not start payment for your order. Please contact support for help."
msgstr ""
"Hatukuweza kuanzisha malipo ya agizo lako. Tafadhali wasiliana na huduma kwa "
"wateja upate msaada."

#: store/views.py:279
#, python-format
msgid ""
"We could not start the M-Pesa payment. Your order %(order_id)s was saved; "
"please try again or contact support."
msgstr ""
"Hatukuweza kuanzisha malipo ya M-Pesa. Agizo lako %(order_id)s "
"limehifadhiwa; jaribu tena au wasiliana na usaidizi."

#: store/views.py:289
msgid "Your order is awaiting M-Pesa payment confirmation."
msgstr "Agizo lako linasubiri uthibitisho wa malipo ya M-Pesa."

#: store/views.py:292
#, python-format
msgid ""
"Payment request sent. Enter your M-Pesa PIN on your phone to complete order "
